# 环境配置示例文件
# 复制此文件为 .env 并填入实际配置

# 基本配置
PROJECT_NAME=金融分析系统API
DEBUG=True
HOST=0.0.0.0
PORT=8000

# 安全配置（生产环境必须修改）
SECRET_KEY=your-secret-key-change-in-production-environment
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# 数据库配置
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/financial_analysis

# AKShare配置
AKSHARE_TIMEOUT=30
